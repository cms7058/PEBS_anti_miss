PORT=8087
DATABASE_PATH=/var/lib/familyguard/family.sqlite3
TRUST_LOCAL_PROXY=1
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
# Configure later, after providing Apple Developer push credentials:
# APNS_KEY_PATH=/etc/familyguard/apns/AuthKey.p8
# APNS_KEY_ID=replace_me
# APNS_TEAM_ID=replace_me
# APNS_TOPIC=com.mingyueacai.ios-app-antimiss
# APNS_ENV=sandbox
