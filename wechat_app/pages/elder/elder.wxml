<view class="page">
 <view class="error" wx:if="{{error}}">{{error}}</view>
 <view wx:if="{{elder}}">
  <view class="row"><view class="title">{{elder.name}}</view><text class="tag">{{elder.is_owner ? '主管理员' : elder.can_edit ? '可修改设置' : '查看权限'}}</text></view>
  <view class="muted">{{elder.paired ? '老人设备已绑定' : '尚未绑定老人设备'}} · {{elder.syncLabel}}</view>
  <view class="card">
   <view class="heading">最近上报位置</view><view class="{{elder.stale ? 'warning' : 'muted'}}">{{elder.lastLabel}}</view><view>{{elder.accuracyLabel}}</view>
   <map wx:if="{{hasMap}}" class="map" latitude="{{mapCenter.lat}}" longitude="{{mapCenter.lon}}" markers="{{markers}}" circles="{{circles}}" scale="14"/>
   <view class="muted selectable">{{elder.coordinateLabel}}</view><view class="muted">页面刷新：{{lastRefresh}}。页面打开期间约每 15 秒刷新。</view><button bindtap="refresh" disabled="{{busy}}">立即刷新</button>
  </view>
  <view class="card" wx:if="{{elder.is_owner && !elder.paired}}"><view class="heading">绑定老人端</view><button bindtap="pair" disabled="{{busy}}">生成新的绑定码</button><view class="code selectable">{{code}}</view><view wx:if="{{code}}" class="muted">有效期至 {{expires}}</view><button wx:if="{{code}}" bindtap="copy">复制绑定码</button></view>
  <view class="card"><view class="heading">守护设置</view>
   <view>{{elder.settings.fence ? '已启用日常围栏' : '尚未设置日常围栏'}}</view>
   <view wx:if="{{elder.settings.trip}}">目的地：{{elder.settings.trip.name}} · {{elder.settings.trip.status === 'arrived' ? '已到达，等待结束行程' : '行程进行中'}}</view>
   <view class="muted">越界持续 {{elder.settings.outside_delay}} 秒提醒；位置 {{elder.settings.offline_after}} 秒未更新提醒。行程期间暂停日常围栏。</view>
   <view wx:if="{{elder.can_edit}}"><button data-mode="fence" bindtap="settings">设置电子围栏</button><button data-mode="trip" bindtap="settings">指定目的地与到达时间</button><button data-mode="threshold" bindtap="settings">调整提醒时间</button><button wx:if="{{elder.settings.trip}}" bindtap="endTrip" disabled="{{busy}}">结束本次行程</button></view>
   <button wx:if="{{elder.is_owner}}" bindtap="members">管理授权家属</button>
  </view>
  <view class="heading">异常记录</view><view class="muted" wx:if="{{!elder.events.length}}">暂无异常记录</view>
  <view class="card" wx:for="{{elder.events}}" wx:key="id"><view class="row"><text class="heading">{{item.message}}</text><text class="tag">{{item.active ? '异常仍在持续' : '已恢复'}}</text></view><view class="muted">{{item.timeLabel}}</view><view class="selectable">{{item.locationLabel}}</view><view wx:if="{{item.handler}}">已由 {{item.handler}} 接手</view><button wx:if="{{item.location}}" data-id="{{item.id}}" bindtap="eventMap">查看事件位置</button><button wx:if="{{item.active && !item.handler}}" data-id="{{item.id}}" bindtap="ack" disabled="{{busy}}">我来接手</button></view>
 </view>
</view>
