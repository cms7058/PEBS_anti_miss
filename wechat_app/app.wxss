page { background:#f3f7f7; color:#19383e; font-size:30rpx; line-height:1.6; }
.page { padding:38rpx 30rpx 80rpx; max-width:1000rpx; margin:auto; }
.title { font-size:52rpx; font-weight:700; line-height:1.3; margin:14rpx 0 22rpx; }
.eyebrow { color:#087f8c; font-size:24rpx; letter-spacing:3rpx; }
.heading { font-size:34rpx; font-weight:600; margin-bottom:12rpx; }
.card { background:white; border:1rpx solid #e0ebec; border-radius:26rpx; padding:28rpx; margin:26rpx 0; }
.muted { color:#637b80; font-size:25rpx; margin:10rpx 0; }
.label { color:#526d72; margin:22rpx 0 10rpx; font-size:26rpx; }
input { border:1rpx solid #cfdddf; border-radius:14rpx; padding:18rpx; min-height:48rpx; background:#fafcfc; }
.row { display:flex; justify-content:space-between; align-items:center; gap:14rpx; margin:14rpx 0; }
button { margin-top:20rpx; font-size:29rpx; border-radius:16rpx; background:#eaf3f4; color:#176572; }
button::after { border:none; }
.primary { background:#087f8c; color:white; }
.secondary { background:#e6f0f1; color:#176572; }
.danger { color:#b34432; background:#fff0eb; }
.error { color:#a92e24; background:#ffede9; padding:22rpx; border-radius:14rpx; margin:20rpx 0; word-break:break-all; }
.notice { background:#fff4dd; color:#80561e; border-radius:16rpx; padding:22rpx; font-size:25rpx; }
.warning { color:#a66118; }
.tag { border-radius:12rpx; padding:6rpx 12rpx; background:#e7f3f2; font-size:23rpx; white-space:nowrap; }
.link { color:#087f8c; margin-top:18rpx; }
.map { width:100%; height:520rpx; border-radius:18rpx; margin:22rpx 0; }
.code { font-size:36rpx; color:#087f8c; word-break:break-all; margin:20rpx 0; }
.selectable { user-select:text; word-break:break-all; }

/* Elder detail dashboard: position action first, compact rule cards below. */
.elder-dashboard .location-card { padding:0; overflow:hidden; }
.elder-dashboard .map-frame { position:relative; }
.elder-dashboard .map { height:440rpx; margin:0; border-radius:0; }
.elder-dashboard .empty-map { height:300rpx; display:flex; align-items:center; justify-content:center; background:#e5efef; color:#637b80; }
.elder-dashboard .map-badge { position:absolute; top:22rpx; left:22rpx; border-radius:40rpx; background:#fffffff0; color:#176572; font-size:24rpx; padding:8rpx 20rpx; }
.elder-dashboard .location-content { padding:26rpx; }
.elder-dashboard .metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14rpx; }
.elder-dashboard .metric-caption { color:#637b80; font-size:24rpx; font-weight:400; }
.elder-dashboard .metric-value { font-size:34rpx; font-weight:600; }
.elder-dashboard .map-actions { display:flex; gap:18rpx; justify-content:space-between; }
.elder-dashboard .map-actions button { background:transparent; padding:10rpx 0; font-size:26rpx; margin:4rpx 0; }
.elder-dashboard .small-note { font-size:22rpx; margin-bottom:0; }
.elder-dashboard .guard-card { padding:22rpx; margin-top:12rpx; }
.elder-dashboard .rule-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18rpx; }
.elder-dashboard .rule-tile { width:100%; box-sizing:border-box; padding:24rpx; margin:0; text-align:left; line-height:1.6; border-radius:20rpx; }
.elder-dashboard .fence-tile { background:#edf6f3; }
.elder-dashboard .trip-tile { background:#fff5e8; }
.elder-dashboard .rule-icon { font-size:38rpx; color:#087f8c; margin-bottom:14rpx; }
.elder-dashboard .trip-tile .rule-icon { color:#bd791c; }
.elder-dashboard .rule-value { font-size:34rpx; font-weight:600; color:#19383e; margin:10rpx 0; overflow-wrap:anywhere; }
.elder-dashboard .details-panel { margin-top:16rpx; border-top:1rpx solid #e0ebec; padding-top:16rpx; }
